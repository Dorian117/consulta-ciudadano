# Copie este archivo como .env (el .env real NO se sube a git) y reemplace los valores de ejemplo.
# Usuario de Atlas: use uno de aplicacion con permisos minimos, no el administrador del cluster.
MONGO_URI=mongodb+srv://USUARIO_APP:CLAVE_APP@CLUSTER.mongodb.net/?retryWrites=true&w=majority
PORT=3000

# Secreto para firmar sesiones: minimo 32 caracteres aleatorios.
JWT_SECRET=cambie-este-valor-por-un-secreto-largo-y-aleatorio
# Duracion de la sesion: numero seguido de s, m, h o d (por defecto 2h).
JWT_EXPIRA_EN=2h

# Datos del primer administrador (solo los usa: npm run crear-admin).
ADMIN_INICIAL_CEDULA=1000000000
ADMIN_INICIAL_NOMBRES=Administrador
ADMIN_INICIAL_CORREO=admin@ejemplo.com
# Minimo 6 caracteres, con una mayuscula, una minuscula y un digito.
ADMIN_INICIAL_CLAVE=CambieEstaClave1
